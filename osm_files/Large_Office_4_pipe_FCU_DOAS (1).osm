  {03998aff-9b16-48f5-b767-675c707bef1d}, !- Handle
  SYS9ZoneDOASOptimumStartProg0,          !- Name
  IF DaylightSavings==0 && DayOfWeek>1 && Hour==5 && {097da82d-8f5b-4c04-a369-0edd3e0cfdee}<23.9 && {097da82d-8f5b-4c04-a369-0edd3e0cfdee}>1.7, !- Program Line 1
  SET {be149f78-4028-49e0-86ab-b776dd8a5226} = 29.4, !- Program Line 2
  SET {a0c3aa7d-60dd-4ee1-b432-5f65ebcd044d} = 15.6, !- Program Line 3
  ELSEIF DaylightSavings==0 && DayOfWeek==1 && Hour==7 && {097da82d-8f5b-4c04-a369-0edd3e0cfdee}<23.9 && {097da82d-8f5b-4c04-a369-0edd3e0cfdee}>1.7, !- Program Line 4
  SET {be149f78-4028-49e0-86ab-b776dd8a5226} = 29.4, !- Program Line 5
  SET {a0c3aa7d-60dd-4ee1-b432-5f65ebcd044d} = 15.6, !- Program Line 6
  ELSEIF DaylightSavings==1 && DayOfWeek>1 && Hour==4 && {097da82d-8f5b-4c04-a369-0edd3e0cfdee}<23.9 && {097da82d-8f5b-4c04-a369-0edd3e0cfdee}>1.7, !- Program Line 7
  SET {be149f78-4028-49e0-86ab-b776dd8a5226} = 29.4, !- Program Line 8
  SET {a0c3aa7d-60dd-4ee1-b432-5f65ebcd044d} = 15.6, !- Program Line 9
  ELSEIF DaylightSavings==1 && DayOfWeek==1 && Hour==6 && {097da82d-8f5b-4c04-a369-0edd3e0cfdee}<23.9 && {097da82d-8f5b-4c04-a369-0edd3e0cfdee}>1.7, !- Program Line 10
  SET {be149f78-4028-49e0-86ab-b776dd8a5226} = 29.4, !- Program Line 11
  SET {a0c3aa7d-60dd-4ee1-b432-5f65ebcd044d} = 15.6, !- Program Line 12
  ELSE,                                   !- Program Line 13
  SET {be149f78-4028-49e0-86ab-b776dd8a5226} = NULL, !- Program Line 14
